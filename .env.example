# Supabase público (seguro para navegador).
# Copiar desde Project Settings > API en Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL canónica pública del marketplace. En Vercel puede omitirse si VERCEL_PROJECT_PRODUCTION_URL está disponible.
NEXT_PUBLIC_SITE_URL=

# SOLO SERVIDOR. Nunca usar prefijo NEXT_PUBLIC_.
# Se necesita solo para workers internos privilegiados, como el procesador de WhatsApp.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC antiabuso. Generar un valor aleatorio largo (>=32 bytes) y guardarlo solo en servidor.
PUBLIC_BOOKING_RATE_LIMIT_SECRET=

# Integración WhatsApp oficial (Fase 8; server-side, no navegador).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=es_PE
WHATSAPP_TEMPLATE_OWNER_NEW_REQUEST=
WHATSAPP_TEMPLATE_CUSTOMER_CONFIRMED=
WHATSAPP_TEMPLATE_CUSTOMER_CANCELLED=
WHATSAPP_TEMPLATE_CUSTOMER_REMINDER=
WHATSAPP_PROCESSOR_SECRET=
# Si usas Vercel Cron, configura también CRON_SECRET; Vercel lo envía como Bearer.
CRON_SECRET=

# Opcional para scripts locales de SQL/integración; no se expone al navegador.
# LOCAL_DB_URL=
